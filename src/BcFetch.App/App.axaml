<Application
    x:Class="BcFetch.App.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BcFetch.App"
    RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BcText" Color="#14201F" />
                    <SolidColorBrush x:Key="BcMuted" Color="#5E6D6B" />
                    <!-- Decorative hairlines (panels, progress track) versus the boundary of an input, which needs 3:1. -->
                    <SolidColorBrush x:Key="BcLine" Color="#CBD4D2" />
                    <SolidColorBrush x:Key="BcInputBorder" Color="#7F8D8B" />
                    <SolidColorBrush x:Key="BcWindow" Color="#F1F4F3" />
                    <SolidColorBrush x:Key="BcPanel" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BcAccent" Color="#0C7781" />
                    <SolidColorBrush x:Key="BcOnAccent" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="BcSuccess" Color="#2E7D4F" />
                    <SolidColorBrush x:Key="BcWarning" Color="#9C6300" />
                    <SolidColorBrush x:Key="BcDanger" Color="#B5392B" />
                    <!-- Fluent's placeholder grey is about 2:1; the placeholder here is the only help for the URL box. -->
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5E6D6B" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#5E6D6B" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5E6D6B" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BcText" Color="#E3EAE8" />
                    <SolidColorBrush x:Key="BcMuted" Color="#8A9A97" />
                    <SolidColorBrush x:Key="BcLine" Color="#2C373D" />
                    <SolidColorBrush x:Key="BcInputBorder" Color="#5F7078" />
                    <SolidColorBrush x:Key="BcWindow" Color="#141A1E" />
                    <SolidColorBrush x:Key="BcPanel" Color="#0D1114" />
                    <SolidColorBrush x:Key="BcAccent" Color="#3FB8C4" />
                    <SolidColorBrush x:Key="BcOnAccent" Color="#0A1B1D" />
                    <SolidColorBrush x:Key="BcSuccess" Color="#5CCB8A" />
                    <SolidColorBrush x:Key="BcWarning" Color="#E3B341" />
                    <SolidColorBrush x:Key="BcDanger" Color="#FF7A6B" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A9A97" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A9A97" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A9A97" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static local:ThemeTokens.Midnight}">
                    <SolidColorBrush x:Key="BcText" Color="#E4E9F7" />
                    <SolidColorBrush x:Key="BcMuted" Color="#97A3C4" />
                    <SolidColorBrush x:Key="BcLine" Color="#26304D" />
                    <SolidColorBrush x:Key="BcInputBorder" Color="#6677A3" />
                    <SolidColorBrush x:Key="BcWindow" Color="#12182B" />
                    <SolidColorBrush x:Key="BcPanel" Color="#0B1020" />
                    <SolidColorBrush x:Key="BcAccent" Color="#7AA2FF" />
                    <SolidColorBrush x:Key="BcOnAccent" Color="#0A1230" />
                    <SolidColorBrush x:Key="BcSuccess" Color="#6FD39A" />
                    <SolidColorBrush x:Key="BcWarning" Color="#E8B84A" />
                    <SolidColorBrush x:Key="BcDanger" Color="#FF8A80" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#97A3C4" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#97A3C4" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#97A3C4" />
                                    <!-- Fluent derives its accent shades from the palette, which cannot hold a custom variant; set them here. -->
                    <Color x:Key="SystemAccentColor">#7AA2FF</Color>
                    <Color x:Key="SystemAccentColorLight1">#A3BFFF</Color>
                    <Color x:Key="SystemAccentColorLight2">#CCDBFF</Color>
                    <Color x:Key="SystemAccentColorLight3">#F4F8FF</Color>
                    <Color x:Key="SystemAccentColorDark1">#5185FF</Color>
                    <Color x:Key="SystemAccentColorDark2">#2869FF</Color>
                    <Color x:Key="SystemAccentColorDark3">#004DFF</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="{x:Static local:ThemeTokens.Mocha}">
                    <SolidColorBrush x:Key="BcText" Color="#EFE6DD" />
                    <SolidColorBrush x:Key="BcMuted" Color="#AE9C8D" />
                    <SolidColorBrush x:Key="BcLine" Color="#3A2E26" />
                    <SolidColorBrush x:Key="BcInputBorder" Color="#7D6A5B" />
                    <SolidColorBrush x:Key="BcWindow" Color="#1D1612" />
                    <SolidColorBrush x:Key="BcPanel" Color="#15100D" />
                    <SolidColorBrush x:Key="BcAccent" Color="#E0A458" />
                    <SolidColorBrush x:Key="BcOnAccent" Color="#26170A" />
                    <SolidColorBrush x:Key="BcSuccess" Color="#8CCB7A" />
                    <SolidColorBrush x:Key="BcWarning" Color="#F0C060" />
                    <SolidColorBrush x:Key="BcDanger" Color="#FF8C74" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#AE9C8D" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#AE9C8D" />
                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#AE9C8D" />
                                    <!-- Fluent derives its accent shades from the palette, which cannot hold a custom variant; set them here. -->
                    <Color x:Key="SystemAccentColor">#E0A458</Color>
                    <Color x:Key="SystemAccentColorLight1">#E6B77A</Color>
                    <Color x:Key="SystemAccentColorLight2">#EDCA9D</Color>
                    <Color x:Key="SystemAccentColorLight3">#F3DCBF</Color>
                    <Color x:Key="SystemAccentColorDark1">#DA9136</Color>
                    <Color x:Key="SystemAccentColorDark2">#C27D24</Color>
                    <Color x:Key="SystemAccentColorDark3">#A0661E</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <FontFamily x:Key="BcMono">avares://bcfetch/Assets/Fonts#JetBrains Mono</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#0C7781" RegionColor="#F1F4F3" />
                <ColorPaletteResources x:Key="Dark" Accent="#3FB8C4" RegionColor="#141A1E" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="{DynamicResource BcWindow}" />
        </Style>

        <!-- Inputs: flat, one hairline, no inner glow. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BcPanel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BcInputBorder}" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <!-- A scrollable region shows keyboard focus with the accent border. -->
        <Style Selector="Border.region">
            <Setter Property="BorderBrush" Value="{DynamicResource BcLine}" />
        </Style>
        <Style Selector="Border.region:focus-within">
            <Setter Property="BorderBrush" Value="{DynamicResource BcAccent}" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="BorderBrush" Value="{DynamicResource BcInputBorder}" />
        </Style>
        <Style Selector="TextBox.mono">
            <Setter Property="FontFamily" Value="{StaticResource BcMono}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Quiet text buttons for header actions. -->
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource BcMuted}" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
        <Style Selector="Button.quiet:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BcAccent}" />
        </Style>

        <!-- The one filled button. -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{DynamicResource BcAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BcOnAccent}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BcAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource BcOnAccent}" />
            <Setter Property="Opacity" Value="0.88" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BcLine}" />
            <Setter Property="Foreground" Value="{DynamicResource BcMuted}" />
        </Style>
        <Style Selector="Button.danger:not(:disabled)">
            <Setter Property="Foreground" Value="{DynamicResource BcDanger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BcDanger}" />
        </Style>

        <!-- Progress line under the header: thin, flat, accent. -->
        <Style Selector="ProgressBar.line">
            <Setter Property="MinHeight" Value="3" />
            <Setter Property="Height" Value="3" />
            <Setter Property="Background" Value="{DynamicResource BcLine}" />
            <Setter Property="Foreground" Value="{DynamicResource BcAccent}" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="ProgressBar.line /template/ Border#PART_Indicator">
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,8" />
        </Style>
    </Application.Styles>
</Application>
