<Window
    x:Class="BcFetch.App.MainWindow"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BcFetch.App"
    xmlns:p="using:BcFetch.App.Properties"
    Title="bcfetch"
    Width="860"
    Height="640"
    MinWidth="640"
    MinHeight="520"
    Icon="/Assets/Cloud.png"
    WindowStartupLocation="CenterScreen">
    <!--
        Rows are declared in screen order (header, progress line, content, footer), so Tab follows the screen.
        Transparent background: empty gaps must be hit-testable, or drops over them are ignored.
    -->
    <Grid Background="Transparent" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header: wordmark left, quiet actions right. -->
        <Grid Grid.Row="0" Margin="20,10,10,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <!-- Decorative: the name next to it says it, so screen readers skip it. -->
                <Image
                    Width="26"
                    Height="26"
                    Margin="0,0,2,0"
                    VerticalAlignment="Center"
                    AutomationProperties.AccessibilityView="Raw"
                    RenderOptions.BitmapInterpolationMode="HighQuality"
                    Source="avares://bcfetch/Assets/Cloud.png" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="bcfetch" />
                <TextBlock
                    x:Name="LabelAppVersion"
                    Margin="0,0,0,3"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{DynamicResource BcMuted}" />
            </StackPanel>
            <TextBlock
                x:Name="LabelNewVersion"
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Cursor="Hand"
                Foreground="{DynamicResource BcAccent}"
                IsVisible="False"
                PointerPressed="LabelNewVersion_PointerPressed"
                TextDecorations="Underline" />
            <Button
                Grid.Column="3"
                Classes="quiet"
                Click="ButtonAbout_Click"
                Content="{x:Static p:Resources.labelListBoxItemAbout}" />
            <Button
                x:Name="ButtonOpenSettingsWindow"
                Grid.Column="4"
                Classes="quiet"
                Click="ButtonOpenSettingsWindow_Click"
                Content="{x:Static p:Resources.buttonOpenSettingsWindow}"
                ToolTip.Tip="{x:Static p:Resources.buttonOpenSettingsWindow_ToolTip}" />
        </Grid>

        <ProgressBar
            x:Name="ProgressBar"
            AutomationProperties.Name="{x:Static p:Resources.progressOverall}"
            Grid.Row="1"
            Classes="line"
            ShowProgressText="False" />

        <!--
            The content rows share the height that is left: the URL box and the log flex between a minimum and
            a maximum, the track list takes its row only while a run shows it, and the footer always stays reachable.
        -->
        <Grid x:Name="ContentGrid" Grid.Row="2" Margin="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="64" MaxHeight="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="140" />
            </Grid.RowDefinitions>
            <!-- Read out by screen readers when a run ends; invisible on screen. -->
            <TextBlock
                x:Name="LabelAnnouncement"
                Grid.Row="0"
                Width="1"
                Height="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                AutomationProperties.LiveSetting="Polite"
                IsHitTestVisible="False"
                Opacity="0" />
            <TextBox
                x:Name="TextBoxUrls"
                Grid.Row="0"
                Margin="0,0,0,12"
                Classes="mono"
                AcceptsReturn="True"
                AutomationProperties.Name="{x:Static p:Resources.labelUrls}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                TextWrapping="Wrap"
                PlaceholderText="{x:Static p:Resources.urlsPlaceholder}" />

            <!-- Options: discography switch; the destination is a read-only summary, edited in Settings. -->
            <Grid Grid.Row="1" Margin="0,0,0,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <ToggleSwitch
                    x:Name="CheckBoxDownloadDiscography"
                    ToolTip.Tip="{x:Static p:Resources.checkBoxDownloadDiscography_ToolTip}" />
                <TextBlock
                    x:Name="LabelSaveTo"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Foreground="{DynamicResource BcMuted}"
                    PointerPressed="LabelSaveTo_PointerPressed"
                    TextDecorations="Underline"
                    TextTrimming="PathSegmentEllipsis" />
                <Button
                    x:Name="ButtonClear"
                    Grid.Column="2"
                    Classes="quiet"
                    Click="ButtonClear_Click" />
            </Grid>

            <!-- Tracks and log are separate tabs, so each gets the full height. -->
            <TabControl x:Name="TabDetails" Grid.Row="2" Margin="0,0,0,12">
            <TabItem x:Name="TabTracks">
            <Border
                x:Name="TrackPanel"
                Classes="region"
                Background="{DynamicResource BcPanel}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid RowDefinitions="Auto,*">
                    <!-- Result of the batch, shown when it ends: how many are done, skipped and failed. -->
                    <TextBlock
                        x:Name="TrackSummary"
                        Margin="12,8,12,0"
                        FontSize="12.5"
                        IsVisible="False" />
                    <ItemsControl x:Name="TrackList" Grid.Row="1" AutomationProperties.Name="{x:Static p:Resources.labelTracks}">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer
                                    Name="PART_TrackScroll"
                                    AutomationProperties.Name="{x:Static p:Resources.labelTracks}"
                                    Focusable="True"
                                    IsTabStop="True">
                                    <ItemsPresenter Margin="12,8" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:TrackRowViewModel">
                                <Grid Margin="0,3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip.Tip="{Binding Name}" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        Width="120"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="{Binding Name}"
                                        Classes="line"
                                        IsIndeterminate="{Binding Indeterminate}"
                                        Maximum="{Binding Maximum}"
                                        Minimum="0"
                                        ShowProgressText="False"
                                        Value="{Binding Value}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Width="104"
                                        VerticalAlignment="Center"
                                        FontFamily="{StaticResource BcMono}"
                                        FontSize="12"
                                        Foreground="{Binding StatusBrush}"
                                        Text="{Binding Status}"
                                        TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            </TabItem>
            <TabItem x:Name="TabLog">
            <Border
                Classes="region"
                Background="{DynamicResource BcPanel}"
                BorderThickness="1"
                CornerRadius="4">
                <Grid>
                    <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto">
                        <SelectableTextBlock
                            x:Name="LogText"
                            Margin="12,10"
                            AutomationProperties.Name="{x:Static p:Resources.labelLog}"
                            FontFamily="{StaticResource BcMono}"
                            FontSize="12.5"
                            LineHeight="20" />
                    </ScrollViewer>
                    <!-- Empty state: what to do first, until the first line is logged. -->
                    <StackPanel
                        x:Name="EmptyState"
                        Margin="16,14"
                        IsHitTestVisible="False"
                        Spacing="8">
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock Foreground="{DynamicResource BcMuted}" FontFamily="{StaticResource BcMono}" FontSize="12" Text="1" />
                            <TextBlock x:Name="EmptyStep1" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock Foreground="{DynamicResource BcMuted}" FontFamily="{StaticResource BcMono}" FontSize="12" Text="2" />
                            <TextBlock x:Name="EmptyStep2" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock Foreground="{DynamicResource BcMuted}" FontFamily="{StaticResource BcMono}" FontSize="12" Text="3" />
                            <TextBlock x:Name="EmptyStep3" Grid.Column="1" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock
                            x:Name="EmptyExample"
                            Margin="0,10,0,0"
                            FontSize="12.5"
                            Foreground="{DynamicResource BcMuted}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="EmptyDiscography"
                            FontSize="12.5"
                            Foreground="{DynamicResource BcMuted}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
            </TabItem>
            </TabControl>
        </Grid>
        <!-- Footer: readouts left (they give way first when the window is narrow), actions right. -->
        <Grid Grid.Row="3" Margin="20,12,20,18" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Grid Grid.Column="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock
                    x:Name="LabelProgress"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource BcMono}"
                    FontSize="13"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="LabelDownloadSpeed"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource BcMono}"
                    FontSize="13"
                    Foreground="{DynamicResource BcMuted}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
            <Button
                x:Name="ButtonStop"
                Grid.Column="1"
                Classes="danger"
                Padding="18,9"
                Click="ButtonStop_Click"
                Content="{x:Static p:Resources.buttonStop}"
                IsEnabled="False"
                IsVisible="False" />
            <Button
                x:Name="ButtonStart"
                Grid.Column="2"
                Classes="primary"
                Click="ButtonStart_Click"
                Content="{x:Static p:Resources.buttonStart}" />
        </Grid>
    </Grid>
</Window>
