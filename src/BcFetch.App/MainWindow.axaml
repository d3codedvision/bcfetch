<Window
    x:Class="BcFetch.App.MainWindow"
    x:ClassModifier="internal"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BcFetch.App"
    xmlns:p="using:BcFetch.App.Properties"
    Title="bcfetch"
    Width="860"
    Height="640"
    MinWidth="640"
    MinHeight="480"
    Icon="/Assets/Cloud.png"
    WindowStartupLocation="CenterScreen">
    <!-- Transparent background: empty gaps must be hit-testable, or drops over them are ignored. -->
    <DockPanel Background="Transparent">
        <!-- Header: wordmark left, quiet actions right. -->
        <Grid DockPanel.Dock="Top" Margin="20,10,10,8" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="Bold"
                    Text="bcfetch" />
                <TextBlock
                    x:Name="LabelAppVersion"
                    Margin="0,0,0,3"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    Foreground="{DynamicResource BcMuted}" />
            </StackPanel>
            <TextBlock
                x:Name="LabelNewVersion"
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Cursor="Hand"
                Foreground="{DynamicResource BcAccent}"
                IsVisible="False"
                PointerPressed="LabelNewVersion_PointerPressed"
                TextDecorations="Underline" />
            <Button
                Grid.Column="3"
                Classes="quiet"
                Click="ButtonAbout_Click"
                Content="{x:Static p:Resources.labelListBoxItemAbout}" />
            <Button
                x:Name="ButtonOpenSettingsWindow"
                Grid.Column="4"
                Classes="quiet"
                Click="ButtonOpenSettingsWindow_Click"
                Content="{x:Static p:Resources.buttonOpenSettingsWindow}"
                ToolTip.Tip="{x:Static p:Resources.buttonOpenSettingsWindow_ToolTip}" />
        </Grid>

        <ProgressBar
            x:Name="ProgressBar"
            AutomationProperties.Name="{x:Static p:Resources.progressOverall}"
            Classes="line"
            DockPanel.Dock="Top"
            ShowProgressText="False" />

        <!-- Footer: readouts left, actions right. -->
        <Grid DockPanel.Dock="Bottom" Margin="20,12,20,18" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
            <TextBlock x:Name="LabelProgress" Grid.Column="0" VerticalAlignment="Center" FontFamily="{StaticResource BcMono}" FontSize="13" />
            <TextBlock
                x:Name="LabelDownloadSpeed"
                Grid.Column="1"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource BcMono}"
                FontSize="13"
                Foreground="{DynamicResource BcMuted}" />
            <Button
                x:Name="ButtonStop"
                Grid.Column="3"
                Classes="danger"
                Padding="18,9"
                Click="ButtonStop_Click"
                Content="{x:Static p:Resources.buttonStop}"
                IsEnabled="False" />
            <Button
                x:Name="ButtonStart"
                Grid.Column="4"
                Classes="primary"
                Click="ButtonStart_Click"
                Content="{x:Static p:Resources.buttonStart}" />
        </Grid>

        <!--
            The content rows share the height that is left: the URL box and the log flex between a minimum and
            a maximum, the track list takes its row only while a run shows it, and the footer always stays reachable.
        -->
        <Grid x:Name="ContentGrid" Margin="20,16,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="64" MaxHeight="140" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="0" />
                <RowDefinition Height="2*" MinHeight="72" />
            </Grid.RowDefinitions>
            <TextBox
                x:Name="TextBoxUrls"
                Grid.Row="0"
                Margin="0,0,0,12"
                Classes="mono"
                AcceptsReturn="True"
                AutomationProperties.Name="{x:Static p:Resources.labelUrls}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                TextWrapping="Wrap"
                PlaceholderText="{x:Static p:Resources.textBoxUrlsPlaceholder}" />

            <StackPanel Grid.Row="1" Margin="0,0,0,12" Spacing="8">
                <Label
                    Padding="0"
                    Content="{x:Static p:Resources.labelDownloadsPath}"
                    Foreground="{DynamicResource BcMuted}"
                    Target="{Binding #TextBoxDownloadsPath}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox
                        x:Name="TextBoxDownloadsPath"
                        Grid.Column="0"
                        Classes="mono"
                        ToolTip.Tip="{x:Static p:Resources.textBoxDownloadsPath_ToolTip}" />
                    <Button
                        x:Name="ButtonBrowse"
                        Grid.Column="1"
                        AutomationProperties.Name="{x:Static p:Resources.buttonBrowse_ToolTip}"
                        Click="ButtonBrowse_Click"
                        Content="{x:Static p:Resources.buttonBrowse}"
                        ToolTip.Tip="{x:Static p:Resources.buttonBrowse_ToolTip}" />
                </Grid>
                <ToggleSwitch
                    x:Name="CheckBoxDownloadDiscography"
                    ToolTip.Tip="{x:Static p:Resources.checkBoxDownloadDiscography_ToolTip}" />
            </StackPanel>

            <Border
                x:Name="TrackPanel"
                Grid.Row="2"
                Margin="0,0,0,12"
                IsVisible="False"
                Background="{DynamicResource BcPanel}"
                BorderBrush="{DynamicResource BcLine}"
                BorderThickness="1"
                CornerRadius="4">
                <ItemsControl x:Name="TrackList" AutomationProperties.Name="{x:Static p:Resources.labelTracks}">
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <ScrollViewer>
                                <ItemsPresenter Margin="12,8" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:TrackRowViewModel">
                            <Grid Margin="0,3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding Name}" />
                                <ProgressBar
                                    Grid.Column="1"
                                    Width="120"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{Binding Name}"
                                    Classes="line"
                                    IsIndeterminate="{Binding Indeterminate}"
                                    Maximum="{Binding Maximum}"
                                    Minimum="0"
                                    ShowProgressText="False"
                                    Value="{Binding Value}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Width="104"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource BcMono}"
                                    FontSize="12"
                                    Foreground="{Binding StatusBrush}"
                                    Text="{Binding Status}"
                                    TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border
                Grid.Row="3"
                Background="{DynamicResource BcPanel}"
                BorderBrush="{DynamicResource BcLine}"
                BorderThickness="1"
                CornerRadius="4">
                <ScrollViewer x:Name="LogScroll" HorizontalScrollBarVisibility="Auto">
                    <SelectableTextBlock
                        x:Name="LogText"
                        Margin="12,10"
                        AutomationProperties.Name="{x:Static p:Resources.labelLog}"
                        FontFamily="{StaticResource BcMono}"
                        FontSize="12.5"
                        LineHeight="20" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
